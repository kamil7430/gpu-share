@rendermode InteractiveServer
@inject IPaymentService PaymentService
@inject IAppNotifier Notifier
@inject IFormatters Formatters

<div class="wallet-layout card">

    <!-- BALANCE -->
    <div class="wallet-card balance-card">
        <div class="balance-header">
            <h3>Wallet</h3>
        </div>
        @if (_balance != null)
        {
            <div class="balance-value">@Formatters.FormatUsd(_balance.TotalUsdCents)</div>
            <div class="balance-details">
                <div class="balance-row">
                    <span>Locked Funds</span>
                    <span>@Formatters.FormatUsd(_balance.LockedUsdCents)</span>
                </div>
                <div class="balance-row">
                    <span>Available Balance</span>
                    <span>@Formatters.FormatUsd(_balance.TotalUsdCents - _balance.LockedUsdCents)</span>
                </div>
            </div>
        }
        else
        {
            <p>Loading balance...</p>
        }
    </div>

    <!-- TOP UP -->
    <div class="wallet-card">
        <button class="btn-primary" @onclick="ToggleTopUp">Top up</button>
        @if (_showTopUp)
        {
            <div style="margin-top: 12px;">
                <label for="topup-amount">Amount (USD)</label>
                <input id="topup-amount" type="number" min="1" step="1"
                       @bind="_topUpDollars" style="display:block; width:100%; margin: 8px 0;" />
                <button class="btn-primary" @onclick="ConfirmTopUpAsync">Confirm</button>
            </div>
        }
    </div>

    <!-- WITHDRAW -->
    <div class="wallet-card">
        <button class="btn-secondary" @onclick="ToggleWithdraw">Withdraw</button>
        @if (_showWithdraw)
        {
            <div style="margin-top: 12px;">
                <label for="withdraw-amount">Amount (USD)</label>
                <input id="withdraw-amount" type="number" min="1" step="1"
                       @bind="_withdrawDollars" style="display:block; width:100%; margin: 8px 0;" />
                <button class="btn-primary" @onclick="ConfirmWithdrawAsync">Confirm</button>
            </div>
        }
    </div>

</div>

@code {

    private WalletBalance? _balance;
    private bool _showTopUp = false;
    private bool _showWithdraw = false;
    private decimal _topUpDollars = 10;
    private decimal _withdrawDollars = 10;

    protected override async Task OnInitializedAsync()
    {
        _balance = await PaymentService.GetWalletBalanceAsync();
    }

    private void ToggleTopUp()
    {
        _showTopUp = !_showTopUp;
        _showWithdraw = false;   // only one panel open at a time
    }

    private void ToggleWithdraw()
    {
        _showWithdraw = !_showWithdraw;
        _showTopUp = false;
    }

    private async Task ConfirmTopUpAsync()
    {
        try
        {
            await PaymentService.TopUpAsync(new TopUpRequest
            {
                AmountUsdCents = (int)(_topUpDollars * 100),
                Method = PaymentMethod.CARD,
            });
            _balance = await PaymentService.GetWalletBalanceAsync();
            _showTopUp = false;
            Notifier.ShowInfo($"Topped up ${_topUpDollars:0.00} successfully.");
        }
        catch (Exception ex)
        {
            Notifier.ShowError($"Top up failed: {ex.Message}");
        }
    }

    private async Task ConfirmWithdrawAsync()
    {
        try
        {
            await PaymentService.WithdrawAsync(new WithdrawRequest
            {
                AmountUsdCents = (int)(_withdrawDollars * 100),
                Method = PaymentMethod.BANK_TRANSFER,
            });
            _balance = await PaymentService.GetWalletBalanceAsync();
            _showWithdraw = false;
            Notifier.ShowInfo($"Withdrawal of ${_withdrawDollars:0.00} initiated.");
        }
        catch (Exception ex)
        {
            Notifier.ShowError($"Withdrawal failed: {ex.Message}");
        }
    }
}
