@using System.ComponentModel.DataAnnotations
@using MudBlazor
@using Microsoft.AspNetCore.Components.Forms;
@inject IFormatters Formatters
@inject IOrderService OrderService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@* Re-enable with the package-upload section below:
@inject IFileService FileService
*@

@*
The order request follows the API contract (contract/backend/paths/api/orders/orders.yaml):
dockerImage carries the NAME of a Docker image to run on the device (e.g. "ubuntu:latest").
The contract has no package-upload endpoint, so the form collects the image name directly.
If the API grows package uploads (Dockerfile / compose archives), re-enable the commented
"Deployment Package" section below to offer "upload package OR image name" like most
cloud GPU platforms.
*@

@if (Device != null)
{
    <div class="order-form-container card">

        <div class="order-header">
            <h3>Order this GPU</h3>

            <p>
                Configure your GPU session and deployment container.
            </p>
        </div>

        <EditForm Model="orderModel" OnValidSubmit="SubmitOrder">

            <DataAnnotationsValidator />
            <ValidationSummary />

            <!-- START --><!-- DURATION -->
            <div class="form-section flex-row">
                <MudDatePicker Label="Start Date" Editable="true" Placeholder="dd.mm.yyyy" Mask="@(new DateMask("dd.MM.yyyy"))" DateFormat="dd.MM.yyyy" @bind-Date="orderModel.StartDate" ShowToolbar="false" Variant="Variant.Text" />
                <MudTimePicker Label="Start Time" Placeholder="hh:mm" Editable="true" @bind-Time="orderModel.StartTime" Variant="Variant.Text" />
                <MudNumericField @bind-Value="orderModel.DurationHours" Label="Duration (hours)" Min="1" Max="168" Variant="Variant.Text" />
            </div>

            <!-- DOCKER -->
            <div class="form-section">
                <MudTextField @bind-Value="orderModel.DockerImage"
                For="@(() => orderModel.DockerImage)"
                Label="Docker Image"
                Placeholder="e.g. pytorch/pytorch:2.0-cuda11.7"
                HelperText="Name of the Docker image to run on the device"
                Variant="Variant.Text" />
            </div>

            @*
            Deployment-package upload — disabled until the API contract has an upload
            endpoint and the order request can reference a package. Re-enable together
            with the IFileService injection at the top and the OnFileSelected handler
            plus _selectedFile/_uploadedFileUrl fields in @code.

            <div class="form-section">

                <label>Deployment Package</label>

                <MudFileUpload T="IBrowserFile"
                DragAndDrop="true"
                FilesChanged="OnFileSelected"
                Accept=".zip,.tar,.gz,.dockerfile,.yml,.yaml">
                    <SelectedTemplate Context="another_name"/>
                </MudFileUpload>

                @if (_selectedFile is not null)
                {
                    <div class="uploaded-file">

                        <div class="uploaded-file-info">
                            <MudIcon Icon="@Icons.Material.Filled.Description"
                            Size="Size.Small" />

                            <span>@_selectedFile.Name</span>

                            <span class="file-size">
                                (@(_selectedFile.Size / 1024) KB)
                            </span>
                        </div>

                        <MudIconButton Icon="@Icons.Material.Filled.Close"
                        Size="Size.Small"
                        Color="Color.Primary"
                        Class="remove-file-btn"
                        OnClick="@(() => _selectedFile = null)" />

                    </div>
                }

                @if (_selectedFile == null)
                {
                    <div class="input-hint">
                        Upload a Docker deployment archive or compose configuration
                    </div>
                }

            </div>
            *@

            <!-- ESTIMATION -->
            <div class="cost-card">

                <div class="cost-row">
                    <span>GPU Price</span>
                    <span>$@Formatters.FormatUsd(Device.PricePerHourUsdCents) / hour</span>
                </div>

                <div class="cost-row">
                    <span>Duration</span>
                    <span>@orderModel.DurationHours h</span>
                </div>

                <div class="cost-divider"></div>

                <div class="cost-total">
                    <span style="color: #4C6EB2">Estimated Total</span>

                    <span style="color: #4C6EB2">
                        $@EstimatedCost.ToString("0.00")
                    </span>
                </div>

            </div>

            <!-- SUBMIT -->
            <button type="submit"
            class="btn-primary order-btn">
                Order GPU
            </button>

        </EditForm>

        @if(_orderId != null)
        {
            <a class="link" href="@($"/order/{_orderId}")">View order</a>
        }
    </div>
}

@code {

    [Parameter] public Device? Device { get; set; } = null;

    private int? _orderId = null;

    // Deployment-package upload support — see the commented section in the markup.
    //
    // private IBrowserFile? _selectedFile;
    // private string? _uploadedFileUrl;
    //
    // private async Task OnFileSelected(IBrowserFile? file)
    // {
    //     _selectedFile = file;
    //
    //     if (file is null)
    //     {
    //         _uploadedFileUrl = null;
    //         return;
    //     }
    //
    //     try
    //     {
    //         var uploadResult = await FileService.UploadAsync(file);
    //         _uploadedFileUrl = uploadResult.Url;
    //         Snackbar.Add("File uploaded successfully", Severity.Success);
    //     }
    //     catch (Exception ex)
    //     {
    //         _selectedFile = null;
    //         _uploadedFileUrl = null;
    //         Snackbar.Add("File upload failed", Severity.Error);
    //         Console.WriteLine(ex);
    //     }
    // }

    private OrderModel orderModel = new()
    {
        StartDate = DateTime.Today.AddDays(1),
        StartTime = new TimeSpan(12, 0, 0),
        DurationHours = 1
    };

    private decimal EstimatedCost =>
        Device!.PricePerHourUsdCents / 100.0m * orderModel.DurationHours;

    public class OrderModel
    {
        [Required]
        public DateTime? StartDate { get; set; }

        [Required]
        public TimeSpan? StartTime { get; set; }

        [Range(1, 168)]
        public int DurationHours { get; set; }

        // orders.yaml requires dockerImage: the name of the Docker image
        // to run on the device, e.g. "ubuntu:latest".
        [Required(ErrorMessage = "Docker image is required")]
        public string DockerImage { get; set; } = "";
    }

    private async Task SubmitOrder()
    {
        // TODO:
        // - validate conflicts
        // - payment flow
        // - deployment scheduling

        if (Device is null)
            return;

        if (orderModel.StartDate is null || orderModel.StartTime is null)
        {
            Snackbar.Add("Start date and time are required", Severity.Error);
            return;
        }

        // EditForm validation catches this in the UI; guard kept for direct calls
        if (string.IsNullOrWhiteSpace(orderModel.DockerImage))
        {
            Snackbar.Add("Docker image is required", Severity.Error);
            return;
        }

        var startAt = orderModel.StartDate.Value.Date + orderModel.StartTime.Value;

        var request = new CreateOrderRequest
        {
            DeviceId = Device.DeviceId,
            StartTime = startAt,
            DurationHours = orderModel.DurationHours,
            DockerImage = orderModel.DockerImage,
        };

        try
        {
            var result = await OrderService.CreateOrderAsync(request);
            _orderId = result.OrderId;
            Snackbar.Add("Order created successfully", Severity.Success);
            Navigation.NavigateTo($"/order/{result.OrderId}");
        }
        catch (ApiException ex)
        {
            if (ex.StatusCode == HttpStatusCode.BadRequest)
            {
                Snackbar.Add("Invalid order configuration", Severity.Error);
            }
            else if (ex.StatusCode == HttpStatusCode.PaymentRequired)
            {
                Snackbar.Add("Insufficient wallet balance", Severity.Error);
            }
            else
            {
                Snackbar.Add("Unexpected error while creating order", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add("Unexpected error while creating order", Severity.Error);
            Console.WriteLine(ex);
        }
    }
}
