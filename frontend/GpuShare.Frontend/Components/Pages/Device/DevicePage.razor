@page "/device/{ModeString}/{DeviceId:int}"
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor.Charts
@using GpuShare.Frontend.Models
@using GpuShare.Frontend.State
@inject IAuthState AuthState
@inject IDeviceService DeviceService
@* @inject ILogger<DevicePage> Logger *@
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

@* what happens when the reserved time run out but the job is not finished 

*@

<div class="cards-container">
    <div class="page-header" style="margin-bottom: 8px;">
        <NavLink href="@_profileLink" class="back-link">&lt; Back to Profile</NavLink>
    </div>

    @if (_device == null)
    {
        <div class="card">Could not load device data. Try again later.</div>
    }
    else
    {
        <!-- Info card -->
        @if (_mode != DevicePageMode.Add)
        {
            <DeviceInfoCard Device="@_device" Username="@_username"></DeviceInfoCard>
        }

        <!--  Edit form -->
        @if ((_mode == DevicePageMode.Edit || _mode == DevicePageMode.Add))
        {
            <AuthorizeView>
                <Authorized>
                    <EditDeviceForm Device="@_device" Mode="@_mode" OnSave="HandleDeviceSaved"></EditDeviceForm>
                </Authorized>
            </AuthorizeView>
        }

        @if (_mode != DevicePageMode.Add)
        {
            <AuthorizeView>
                <Authorized>
                    <!-- Telemetry -->
                    <TelemetryCard Device="@_device"></TelemetryCard>

                    <!-- Reservation Calendar -->
                    <ReservationCalendar DeviceId="@_device.DeviceId"></ReservationCalendar>
                </Authorized>
                <NotAuthorized>
                    <!-- Opinions -->
                    <div class="card">
                        <h4 style="margin-bottom: 16px;">Owner rating: 4.5 </h4>
                        <h4 style="margin-bottom: 24px;">Opinions about this gpu:</h4>
                        <ReviewsList></ReviewsList>
                    </div>

                    <!-- Order form -->
                    <DeviceOrderForm></DeviceOrderForm>
                </NotAuthorized>
            </AuthorizeView>
        }
    }

</div>

@code {
    [Parameter] public string ModeString { get; set; } = "view"; // "view", "edit", "add"
    [Parameter] public int DeviceId { get; set; }

    private DevicePageMode _mode = DevicePageMode.View;
    private Device? _device = null;
    private string _username = "user1";
    private string _profileLink = "";

    protected override void OnInitialized()
    {
    }

    protected override async Task OnParametersSetAsync()
    {
        _mode = Enum.TryParse<DevicePageMode>(ModeString, ignoreCase: true, out var mode) ? mode : DevicePageMode.View;
        try
        {
            _device = await DeviceService.GetDeviceAsync(DeviceId);
            _username = _device.OwnerUsername;
            _profileLink = $"/profile/{_username}";
        }
        catch
        {
            _device = null;
        }
    }

    private async Task HandleDeviceSaved(Device savedGpu)
    {
        // _device = savedGpu;
        if (_device == null)
        {
            // This should never happen, but just in case
            return;
        }
        _mode = DevicePageMode.View;

        var request = new UpdateDeviceRequest
        {
            Name = savedGpu.Name != _device.Name ? savedGpu.Name : null,
            GpuModel = savedGpu.GpuModel != _device.GpuModel ? savedGpu.GpuModel : null,
            VramMb = savedGpu.VramMb != _device.VramMb ? savedGpu.VramMb : null,
            CudaCores = savedGpu.CudaCores != _device.CudaCores ? savedGpu.CudaCores : null,
            DriverVersion = savedGpu.DriverVersion != _device.DriverVersion ? savedGpu.DriverVersion : null,
            PricePerHourUsdCents = savedGpu.PricePerHourUsdCents != _device.PricePerHourUsdCents ? savedGpu.PricePerHourUsdCents : null,
            Frameworks = savedGpu.Frameworks != _device.Frameworks ? savedGpu.Frameworks : null
        };

        try
        {
            var device = await DeviceService.UpdateDeviceAsync(DeviceId, _device, request);
            _device = device;
        }
        catch (Exception)
        {
            Snackbar.Add("Error updating device. Please try again.", Severity.Error);
        }
    }

    
}