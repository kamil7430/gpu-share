@inject IDeviceService DeviceService
@inject IOrderService OrderService
@inject IFormatters Formatters
@inject IAppNotifier SnackbarNotifier

@if(_loading == true)
{
    <p>Loading order data...</p>
}
else if (_order != null && _gpu != null && Dispute != null)
{
    <EditForm Model="Dispute" OnValidSubmit="SubmitDispute">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <!-- Rental Reference -->
        <div class="form-card">
            <h4>Rental Reference</h4>

            <div class="spec-grid">
                <div class="spec-box">
                    <div class="label">Order ID</div>
                    <div class="value">#@OrderId</div>
                </div>

                <div class="spec-box">
                    <div class="label">Device</div>
                    <div class="value">@_gpu.Name • @_gpu.GpuModel</div>
                </div>

                <div class="spec-box">
                    <div class="label">Owner</div>
                    <div class="value">@_gpu.OwnerUsername</div>
                </div>

                <div class="spec-box">
                    <div class="label">Rental Period</div>
                    <div class="value">@Formatters.FormatDateTime(_order.StartDate) - @Formatters.FormatDateTime(_order.EndDate)</div>
                </div>
            </div>
        </div>

        <!-- Reason -->
        <div class="form-card">
            <h4>Dispute Reason</h4>
            <MudRadioGroup T="string" @bind-Value="Dispute.Reason" Class="radio-column">
                <MudRadio Color="Color.Primary" T="string" Value='"Hardware mismatch"' Style="width: 100%;">
                    Hardware does not match listing
                </MudRadio>
                <MudRadio Color="Color.Primary" T="string" Value='"Hardware failure"' Style="width: 100%;">
                    GPU failure / instability
                </MudRadio>
                <MudRadio Color="Color.Primary" T="string" Value='"Billing issue"' Style="width: 100%;">
                    Billing or overcharge issue
                </MudRadio>
                <MudRadio Color="Color.Primary" T="string" Value='"Other"' Style="width: 100%;">
                    Other
                </MudRadio>
            </MudRadioGroup>
        </div>

        <!-- Details -->
        <div class="form-card">
            <h4>Problem Details</h4>
            <MudTextField T="string" @bind-Value="Dispute.Description" Variant="Variant.Outlined" Lines="6" Counter="5000" Immediate="true" Placeholder="Describe the issue in detail..." HelperText="Minimum 50 characters required." Class="details-input" />
        </div>

        <!-- Evidence Upload -->
        <div class="form-card">
            <h4>Evidence Upload</h4>

            <div class="upload-hint">
                Upload screenshots, logs, or other evidence.
                Maximum 3 files, 5MB each.
            </div>

            <MudFileUpload T="IReadOnlyList<IBrowserFile>" DragAndDrop="true" FilesChanged="HandleFilesChanged" MaximumFileCount="3" Accept=".pdf,.png,.jpg,.jpeg" Class="mt-2">
                <SelectedTemplate Context="another_name"/>
            </MudFileUpload>

            @if (UploadedFiles.Any())
            {
                <div class="uploaded-files">

                    @foreach (var file in UploadedFiles)
                    {
                        <div class="uploaded-file">
                            <div class="file-info">
                                <MudIcon Icon="@Icons.Material.Filled.Description" Size="Size.Small" />
                                <span>@file.Name</span>
                            </div>
                            <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Error"
                            Size="Size.Small" OnClick="@(() => RemoveFile(file))" />
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Submit -->
        <div class="flex-row mt-6">
            <button class="btn-danger" disabled="@(!CanSubmit)">
                Submit dispute
            </button>
        </div>

    </EditForm>
} else
{
    <p>Dispute data did not load correctly, please retry later.</p>
}

@code
{
    [Parameter] public int OrderId { get; set; }
    [Parameter] public Dispute? Dispute { get; set; } = null;

    private Order? _order = null; 
    private Device? _gpu = null;
    public List<IBrowserFile> UploadedFiles = new();
    private bool _loading = true;

    private bool CanSubmit => Dispute == null? false : !string.IsNullOrWhiteSpace(Dispute.Reason) 
        && !string.IsNullOrWhiteSpace(Dispute.Description) && Dispute.Description.Length >= 50;

    protected override async Task OnParametersSetAsync()
    {
        if (Dispute != null) OrderId = Dispute.OrderId;
        else Dispute = new();

        try
        {
            _order = await OrderService.GetOrderAsync(OrderId);
            _gpu = await DeviceService.GetDeviceAsync(_order!.DeviceId);
        }
        catch (Exception)
        {
            SnackbarNotifier.ShowError("Error getting order and device data for dispute. Please try again.");
            _order = null;
            _gpu = null;
        }
        finally
        {
            _loading = false;
        }
    }

    public async Task HandleFilesChanged(IReadOnlyList<IBrowserFile> files)
    {
        UploadedFiles = files.Take(3).ToList();
        StateHasChanged();
        await Task.CompletedTask;
    }

    public void RemoveFile(IBrowserFile file)
    {
        UploadedFiles.Remove(file);
    }

    private void SubmitDispute()
    {
        Console.WriteLine("Dispute submitted");
    }
}