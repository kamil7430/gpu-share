@page "/dispute/{DisputeId:int}"

@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using MudBlazor

@inject IDisputeService DisputeService

<div class="cards-container">
    <div class="page-top" style="margin-bottom: 8px;">
        <NavLink href="@_orderPage" class="back-link">&lt; Back to Order</NavLink>
    </div>

    <AuthorizeView>
        <Authorized>
            <div class="card">
                <!-- Header -->
                <div class="page-header">
                    <div>
                        <div class="page-subtitle">Order #@(_dispute.OrderId)</div>
                        <h1 style="margin: 0;">Report a Dispute</h1>
                    </div>

                    <MudChip T="string" Color="Color.Warning" Variant="Variant.Filled">
                        Under Review
                    </MudChip>
                </div>

                <!-- Dispute Form -->
                <DisputeForm OrderId="@_dispute.OrderId" />
            </div>

            <!-- Timeline -->
            <TimelineCard />
        </Authorized>
        <NotAuthorized>
            <div class="card">
                <h3>You are not authorized to view this dispute.</h3>
                <p>Please log in to access your orders and disputes.</p>
            </div>
        </NotAuthorized>
    </AuthorizeView>
</div>

@code {
    [Parameter] public int DisputeId { get; set; }
    private Dispute _dispute = null!;

    private string _orderPage = "";

    protected override async Task OnParametersSetAsync()
    {
        _dispute = await DisputeService.GetDisputeAsync(DisputeId);
        _orderPage = $"/order/{_dispute.OrderId}";
    }

    private void SubmitDispute()
    {
        Console.WriteLine("Dispute submitted");
    }
}