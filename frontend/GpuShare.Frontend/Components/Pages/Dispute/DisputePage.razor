@page "/dispute/{DisputeId:int}"
@page "/order/{OrderId:int}/dispute"
@rendermode InteractiveServer
@* existing dispute/create new dispute *@
@* TO-DO: Add dispute view mode *@

@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor

@inject IDisputeService DisputeService

<div class="cards-container">
    @if (_dispute != null)
    {
        <div class="page-top" style="margin-bottom: 8px;">
            <NavLink href="@_orderPage" class="back-link">&lt; Back to Order</NavLink>
        </div>

        <AuthorizeView>
            <Authorized>
                <div class="card">
                    <!-- Header -->
                    <div class="page-header">
                        <div>
                            <div class="page-subtitle">Order #@(_dispute.OrderId)</div>
                            <h1 style="margin: 0;">Report a Dispute</h1>
                        </div>

                        <MudChip T="string" Color="Color.Warning" Variant="Variant.Filled">
                            Under Review
                        </MudChip>
                    </div>

                    <!-- Dispute Form -->
                    <DisputeForm OrderId="@_dispute.OrderId" />
                </div>

                <!-- Timeline -->
                <TimelineCard />
            </Authorized>
            <NotAuthorized>
                <div class="card">
                    <h3>You are not authorized to view this dispute.</h3>
                    <p>Please log in to access your orders and disputes.</p>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    }
    else
    {
        <p>Error loading dispute data. Try again later.</p>
    }
</div>

@code {
    [Parameter] public int? DisputeId { get; set; } = null;
    [Parameter] public int? OrderId { get; set; } = null;
    private Dispute? _dispute = null;

    private string _orderPage = "";

    protected override async Task OnParametersSetAsync()
    {
        if (DisputeId != null)
        {
            _dispute = await DisputeService.GetDisputeAsync(DisputeId.Value);
            _orderPage = $"/order/{_dispute.OrderId}";
        }
        else
        {
            _dispute = new() { OrderId = OrderId ?? 0 };
            _orderPage = $"/order/{OrderId}";
        }
    }

    private void SubmitDispute()
    {
        Console.WriteLine("Dispute submitted");
    }
}