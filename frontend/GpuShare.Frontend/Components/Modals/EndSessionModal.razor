@if (ShowEndModal)
{
    <BaseModal TResult="string" IsVisible="@ShowEndModal" Title="End Session" OnClose="@CloseEndModal" SizeClass="small">
        <ChildContent>
            <div class="end-session-modal">
                @* <MudIcon Icon="@Icons.Material.Filled.WarningAmber" Color="Color.Warning" Size="Size.Large" /> *@
                Are you sure you want to terminate this GPU session?
                <div class="modal-warning">
                    Running workloads may be interrupted immediately.
                </div>
            </div>
        </ChildContent>
        <FooterContent>
            <button class="btn-cancel" @onclick="CloseEndModal">
                Cancel
            </button>

            <button class="btn-danger" @onclick="EndSession">
                End Session
            </button>
        </FooterContent>
    </BaseModal>
}

@code {
    [Parameter] public bool ShowEndModal { get; set; }
    [Parameter] public EventCallback<ModalResult<string>> OnClose { get; set; }

    private async Task CloseEndModal()
    {
        await OnClose.InvokeAsync(ModalResult<string>.Cancel());
    }

    private async Task EndSession()
    {
        Console.WriteLine("Session terminated");
        // call to end session
        await OnClose.InvokeAsync(ModalResult<string>.Ok());
    }
}