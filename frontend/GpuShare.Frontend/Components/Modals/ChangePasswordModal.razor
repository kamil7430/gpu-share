@using System.ComponentModel.DataAnnotations
@using System.Net
@inject IAuthService AuthService
@inject IAuthState AuthState

<BaseModal TResult="string" IsVisible="@IsVisible" Title="Change Password" OnClose="@CloseModal" SizeClass="small">
    <EditForm EditContext="_editContext" OnValidSubmit="HandleChangePassword">
        <DataAnnotationsValidator />
        <ValidationSummary />
        @* <ValidationMessage For="() => _changePasswordModel.OldPassword" /> *@
         
        <input name="oldPassword" autocomplete="current-password" type="password" placeholder="Old Password" @bind-value="_changePasswordModel.OldPassword" />
        <input name="newPassword" autocomplete="new-password" type="password" placeholder="New Password" @bind-value="_changePasswordModel.NewPassword" />
        <input name="confirmPassword" autocomplete="new-password" type="password" placeholder="Confirm Password" @bind-value="_changePasswordModel.ConfirmPassword" />
        <button class="action-btn btn-primary" type="submit">Change Password</button>
    </EditForm>
</BaseModal>

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback<ModalResult<string>> OnClose { get; set; }

    private ChangePasswordModel _changePasswordModel = new ChangePasswordModel();
    private EditContext _editContext = null!;
    private ValidationMessageStore _messageStore = null!;   

    protected override void OnInitialized()
    {
        _editContext = new EditContext(_changePasswordModel);
        _messageStore = new ValidationMessageStore(_editContext);
    }

    private async Task CloseModal()
    {
        await OnClose.InvokeAsync(ModalResult<string>.Cancel());
        _changePasswordModel = new();
        _editContext = new EditContext(_changePasswordModel);
        _messageStore = new ValidationMessageStore(_editContext);
    }

    private async Task HandleChangePassword()
    {
        // This code runs when the user clicks 'Change Password' or hits 'Enter'
        Console.WriteLine($"Changing password for user with old password {_changePasswordModel.OldPassword}");
        try
        {
            await AuthService.ChangePasswordAsync(new() { Username = AuthState.User!.Username,
                OldPassword = _changePasswordModel.OldPassword,
                NewPassword = _changePasswordModel.NewPassword
            });
            await OnClose.InvokeAsync(ModalResult<string>.Ok());

            _changePasswordModel = new();
            _editContext = new EditContext(_changePasswordModel);
            _messageStore = new ValidationMessageStore(_editContext);
        }
        catch (ApiException e)
        {
            _messageStore.Clear();

            if (e.StatusCode == HttpStatusCode.Unauthorized)
            {
                _messageStore.Add(new FieldIdentifier(_changePasswordModel, string.Empty), "Incorrect old password.");
                _editContext.NotifyValidationStateChanged();

                return;
            }
            // do not close on validation error, show error message instead
            await OnClose.InvokeAsync(ModalResult<string>.Fail($"{e.StatusCode}: {e.Message}"));
        }

    }

    private class ChangePasswordModel
    {
        [Required]
        public string OldPassword { get; set; } = "";

        [Required]
        [MinLength(8, ErrorMessage = "Password must be at least 8 characters")]
        [PasswordComplexity(ErrorMessage = "Password must contain at least one uppercase letter, one lowercase letter, and one digit")]
        public string NewPassword { get; set; } = "";
        [Required]

        [Compare("NewPassword", ErrorMessage = "Passwords do not match")]
        public string ConfirmPassword { get; set; } = "";
    }
}