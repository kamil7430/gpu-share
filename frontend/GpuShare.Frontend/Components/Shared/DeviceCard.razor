@rendermode InteractiveServer
@inject NavigationManager Navigation

@if (Device == null)
{
    <div class="gpu-card loading">
        <div class="loading-spinner"></div>
    </div>
    <p>Error loading device data.</p>
}
else
{
<div class="gpu-card">

    <div class="gpu-body">
        <div class="left">
            <div class="gpu-header">
                    <h4><NavLink href="@($"/device/view/{Device.Id}")">@Device.Name</NavLink></h4>
            </div>

                <div>Model: <span style="color: #0A1128;">@Device.Model</span></div>
                @if (!Authorized)
                {
                    <div>Owner name: @Device.OwnerUsername</div>
            }

            <div class="price">
                    Price per hour: @Device.PricePerHour$
            </div>
        </div>

        <div class="middle">
                <div>VRAM MB: <span style="color: #0A1128;">@Device.VramMb</span></div>
                <div>CUDA cores: <span style="color: #0A1128;">@Device.CudaCores</span></div>
                <div>Driver version: <span style="color: #0A1128;">@Device.DriverVersion</span></div>
            <div>
                Supported frameworks:
                    <span style="color: #0A1128;">@string.Join(", ", Device.Frameworks)</span>
            </div>
        </div>

        <div class="right">
                <span class="badge @(Device.IsAvailable ? "available" : "unavailable")">
                    @(Device.IsAvailable ? "Available" : "Unavailable")
            </span>
                @if (Authorized)
            {
                <div class="buttons-wrapper">
                    <button class="btn btn-primary" @onclick="() => EditGpu()">Edit</button>
                    <button class="btn btn-danger" @onclick="() => RemoveGpu()">Remove</button>
                </div>
            }
            else 
            {
                    <button class="btn btn-primary" disabled=@(!Device.IsAvailable) @onclick="() => OrderGpu()">Order</button>
            }
        </div>
    </div>

        @if (Authorized)
    {
        <MudDivider Class="my-2" style="border: 1px solid #3b5a8a" />

        <div class="flex-row" style="justify-content: space-between; color: #0A1128;">
            <span style="font-weight: bold;">Current tenant: -</span>
            <span style="font-weight: bold;">Uptime: 1h 45min</span>
        </div>
    }

</div>
}

<RemoveDeviceModal Gpu="@Device" IsVisible="@showRemoveDeviceModal" OnClose="@(() => showRemoveDeviceModal = false)" />

@code {
    [Parameter] public bool Authorized { get; set; } = false;
    [Parameter] public Device? Device { get; set; } = null;
    private bool showRemoveDeviceModal = false;

    public void OrderGpu()
    {
        if (Device == null) return;

        // Implement order logic here
        Console.WriteLine($"Ordering GPU: {Device.Name}");
        Navigation.NavigateTo($"/device/view/{Device.Id}");
    }

    public void EditGpu()
    {
        if (Device == null) return;

        // Implement edit logic here
        Console.WriteLine($"Editing GPU: {Device.Name}");
        Navigation.NavigateTo($"/device/edit/{Device.Id}");
    }

    public void RemoveGpu()
    {
        if (Device == null) return;

        showRemoveDeviceModal = true;
        // Implement remove logic here
        Console.WriteLine($"Removing GPU: {Device.Name}");
    }
}